echemamr.do_reflux = 1
echemamr.potential_solve = 1
echemamr.potential_solve_int = 1
echemamr.species_implicit_solve=1
echemamr.mechanics_solve = 0

# BOUNDARY CONDITIONS
#periodic 0
#extdir 3
#foextrap 2 
#highorderextrap 5
echemamr.lo_bc_spec = 2 2 2
echemamr.hi_bc_spec = 2 2 2

